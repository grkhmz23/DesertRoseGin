# Shopify Storefront API Configuration
# Get these from your Shopify Admin > Settings > Apps and sales channels > Develop apps

# Client-side (Vite) - public site configuration
VITE_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Server-side / Vercel functions - private, keep secret
SHOPIFY_STORE_URL=your-store.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=your_storefront_access_token

# Database (if using PostgreSQL)
DATABASE_URL=postgresql://user:password@host:port/database

# Analytics (optional)
VITE_CLOUDFLARE_ANALYTICS_TOKEN=your_cloudflare_token

# Private dashboard — all server-side; never use a VITE_ prefix
GA4_PROPERTY_ID=532207662
SEARCH_CONSOLE_SITE_URL=sc-domain:thedesertrosegin.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=dashboard-reader@desert-rose-dashboard-513715.iam.gserviceaccount.com
# Paste the private_key JSON value (literal \n sequences supported)
GOOGLE_PRIVATE_KEY=
# Set independent, random secrets. Review password: >=20 chars, session: >=32.
DASHBOARD_REVIEW_PASSWORD=
DASHBOARD_SESSION_SECRET=
# Customer access stays disabled until handover. No invitations are sent.
DASHBOARD_CLIENT_ACCESS_ENABLED=false
# Separate password, >=20 chars, supplied at handover only.
DASHBOARD_CLIENT_PASSWORD=
